# Copy this file to .env and fill in ONLY the provider(s) you use.
# .env is git-ignored — never commit real keys.

DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CUSTOM_LLM_API_KEY=

# Valuation defaults (decimals). India 10Y G-Sec was ~7.18% on 28-Sep-2026; update as it moves.
ISA_RISK_FREE=0.071
ISA_ERP=0.070
ISA_TERMINAL_G=0.055
ISA_TAX_RATE=0.2517

# Optional password for the dashboard. Leave empty for localhost-only use.
# install-service.sh sets one automatically if you make the dashboard reachable from other devices.
ISA_PASSWORD=

# 1 = offline demo with synthetic data (no internet, no keys needed)
ISA_DEMO=0
